# Git ignore file for AI & ML practicals

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
venv/
env/
.venv/
.env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*.ipynb

# Data files (large datasets — add specific ones if needed)
*.csv
*.xlsx
*.xls
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets and credentials
.env
*.env
secrets.*
credentials.*
*.pem
*.key

# Logs
*.log
logs/
